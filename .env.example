# Supabase — NEW 2026 Key System (sb_secret_...)
# Create a named secret key "trustbench-backend" in Supabase → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # ← server-only, never commit

# Upstash Redis
UPSTASH_REDIS_URL=rediss://default:your-password@your-redis.upstash.io:6379

# Wallet for receiving x402 payments (Base)
PAY_TO_ADDRESS=0xYourBaseAddressHere

# Optional: only if we ever add a public client later
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...