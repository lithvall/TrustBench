SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

UPSTASH_REDIS_URL=rediss://default:your-password@your-redis.upstash.io:6379
PAY_TO_ADDRESS=0xYourBaseAddressHere
PROBE_REGION=global-railway

# Scorecard signing.
# Run `npm run keygen` to generate a fresh Ed25519 keypair, then paste both
# lines below. PEM newlines are escaped as \n so each value fits on one line.
# When set, scorecards are signed with Ed25519 and the public key is served
# at /.well-known/trustbench-pubkey for third-party verification.
TRUSTBENCH_SIGNING_PUBLIC_KEY=
TRUSTBENCH_SIGNING_PRIVATE_KEY=

# Legacy HMAC fallback. Used only when the Ed25519 keys above are not set.
# HMAC signatures are server-internal integrity only — they cannot be
# verified by third parties. Treat as deprecated.
SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Phase 3: Receipt generator + audit endpoint
# ---------------------------------------------------------------------------
# DNS host of this TrustBench deployment. Used in receipt.issuer field and as
# the default for TRUSTBENCH_BASE_URL. Lets staging vs prod coexist with
# different signed receipts traceable to the issuing instance.
TRUSTBENCH_ISSUER_HOST=trustbench.io

# Public base URL for receipts and the public-key endpoint. Used to build
# receipt.audit.audit_url and signature.public_key_url. Should be the URL
# verifiers can fetch the public key from. Defaults to https://<TRUSTBENCH_ISSUER_HOST>.
TRUSTBENCH_BASE_URL=https://trustbench.io

# Signing key identifier. Tracked on every receipt for rotation hygiene.
# Bump on key rotation (e.g. trustbench-2027). Verifiers gate on key_id +
# public_key_url to handle multi-key setups.
TRUSTBENCH_KEY_ID=trustbench-2026

# ---------------------------------------------------------------------------
# Phase 3: Internal paid-probe (scripts/paid-probe.ts) — closeout #7
# ---------------------------------------------------------------------------
# Required only when running `npm run paid-probe`. The probe is just an
# authenticated agent that hits /route + /route/settle on a budget. Spend
# caps live on the agents row, not in env (see phase3-paid-probing.md § Probe
# agent provisioning for the SQL).
#
# In production these go in GitHub Actions secrets, NOT in any .env file
# checked into the repo. Locally, copy this block into .env and fill in.

# Live API key for the probe agent (tb_live_…). Created via `npm run create-agent`.
SCRIPTS_PROBE_API_KEY=

# 0x-prefixed 64-hex-char private key for the probe wallet. Fresh EOA, USDC
# only, never the user's personal wallet. Pre-fund with ~$30 USDC on Base.
SCRIPTS_PROBE_WALLET_PK=

# When 'true', runs the full quote step but skips /route/settle. No on-chain
# settlement, no money moved, no receipts written. Good for first-run sanity.
SCRIPTS_PROBE_DRY_RUN=false

# Number of providers to probe per cron run. The cron fires every 4h; with
# default 4, that's ~24 providers/day across the 6 runs. Bump for catch-up
# if a run is missed; leave at 4 for steady state.
SCRIPTS_PROBE_MAX_PROVIDERS=4

# Comma-separated capabilities to rotate through. Probe picks the
# least-recently-probed (capability, provider) pairs from these.
SCRIPTS_PROBE_CAPABILITIES=search,inference,data

# Email of the probe agent's row in agents table. Used for the soft monthly
# cap pre-check and last-probed-time lookup. Default matches the SQL in
# phase3-paid-probing.md.
SCRIPTS_PROBE_AGENT_EMAIL=probe@trustbench.io

# ---------------------------------------------------------------------------
# Phase 4 P4-7: Strict reservation-based spend caps
# ---------------------------------------------------------------------------
# When 'true', the rolling-cap check in src/spend-caps.ts goes through the
# claim_spend_reservation Postgres function for atomic cap-check + pending
# debit. Closes the documented Phase 3 race where N concurrent quotes could
# overshoot the cap by (N − 1) × max_price. Also starts the in-process
# 60-second sweep that releases reservations on expired quotes
# (src/pending-sweep.ts).
#
# Set to 'true' AFTER applying phase4-schema-spend-cap-reservation.sql in
# Supabase. When unset/false, the legacy approximate-enforcement check is
# used and the sweep does not start. Solo-founder canary lever — can flip
# the flag from Railway dashboard without redeploy.
SPEND_CAP_RESERVATION_ENABLED=false

# ---------------------------------------------------------------------------
# Phase 4 v0.1.0 paywall (per phase4-paywall-design.md + phase4-listing-plan.md)
# ---------------------------------------------------------------------------
# Dedicated revenue wallet on Base. Receive-only. Distinct from the probe
# wallet (SCRIPTS_PROBE_WALLET_PK above) so accounting separation stays clean:
# probe wallet is spend-only, revenue wallet is receive-only and drained
# manually as needed. Address only — no private key on the server. Generate
# in a wallet app (Coinbase Wallet, Rabby, MetaMask) so the private key never
# touches Railway.
TRUSTBENCH_REVENUE_WALLET_ADDRESS=

# Feature flag for the /route paywall. When 'false' (default), /route serves
# free as today. When 'true', /route returns 402 Payment Required with x402
# PaymentRequirements pointing at TRUSTBENCH_REVENUE_WALLET_ADDRESS for the
# routing fee. Solo-founder canary lever — flip from Railway dashboard
# without redeploy once paywall middleware is live.
TRUSTBENCH_PAYWALL_ENABLED=false

# Bazaar discovery extension on POST /route. When true, wraps /route with
# `bazaarResourceServerExtension` + `declareDiscoveryExtension` so the CDP
# facilitator catalogs us into agentic.market / Bazaar after the first
# successful settle. Default false. DO NOT flip on without first running
# the spike route below and seeing EXTENSION-RESPONSES: processing on a
# real settle. See phase4-bazaar-extension-runbook.md.
TRUSTBENCH_BAZAAR_EXTENSION_ENABLED=false

# Throwaway spike route at POST /test/bazaar-spike for the 30-min
# pre-commit Bazaar spike. Exposes a fixed-shape echo endpoint behind the
# discovery extension to validate JSON Schema strict validation works
# end-to-end before flipping the production flag above on /route. Default
# false. Disable after spike passes.
TRUSTBENCH_BAZAAR_SPIKE_ENABLED=false

# Coinbase CDP credentials for the x402 facilitator. REQUIRED for production
# Base mainnet (eip155:8453) settlement. The Foundation facilitator at
# x402.org/facilitator only supports testnet (Base Sepolia + Solana Devnet);
# without CDP creds, Base mainnet paywall calls fail with "No facilitator
# registered for scheme: exact and network: eip155:8453".
#
# Provision at https://portal.cdp.coinbase.com → API Keys → Create API Key.
# Select Ed25519 signature algorithm (recommended). The Quickstart for
# Sellers walks through the flow:
#   https://docs.cdp.coinbase.com/x402/quickstart-for-sellers
#
# CDP_API_KEY_ID: opaque string like organizations/<uuid>/apiKeys/<uuid>.
# CDP_API_KEY_SECRET: Ed25519 PEM, with \n escaped on one line.
#
# Free tier: 1,000 transactions/month, then $0.001/transaction. Plenty for
# v0.1.0 expected volume; revisit if usage grows.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# x402 facilitator URL — FALLBACK ONLY when CDP creds above are unset.
# Default x402.org/facilitator is testnet-only (Base Sepolia + Solana Devnet).
# When CDP creds are set, this var is ignored and the @coinbase/x402 package's
# pre-built facilitator config is used (which points at
# api.cdp.coinbase.com/platform/v2/x402 with automatic JWT auth).
TRUSTBENCH_FACILITATOR_URL=https://x402.org/facilitator

# Per-paying-wallet hourly call limit (v0.1.1 — Critic verdict gate #1).
# X-PAYMENT-paying callers bypass the Bearer flow's spend caps; this is the
# substitute. Counts paid_requests rows with created_at >= now-1h for the
# agent_address. Returns 429 with Retry-After: 60 when exceeded.
# Default 60 = one paid call per minute average across the hour. Set to 0
# to disable. Tunable from Railway dashboard without redeploy.
TRUSTBENCH_PAYWALL_HOURLY_LIMIT=60
