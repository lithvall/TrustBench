# Supabase (create at supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (create at upstash.com)
UPSTASH_REDIS_URL=rediss://default:your-password@your-redis.upstash.io:6379

# Wallet for receiving x402 payments (Base)
PAY_TO_ADDRESS=0xYourBaseAddressHere

# Optional: CDP credentials (for advanced facilitator later)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
